---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import FactorBar from '../../components/FactorBar.astro';
import { getCollection, render } from 'astro:content';
import { FACTORS, totalNixons, formulaString } from '../../data/factors.js';

export async function getStaticPaths() {
  const cases = await getCollection('case-files');
  return cases.map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const total = totalNixons(entry.data.scores);
---

<Base
  title={`${entry.data.title} — The Nixon Index`}
  description={entry.data.summary}
>
  <div class="eyebrow">
    Case File {entry.data.caseNumber} · Ruled{' '}
    {
      entry.data.ruled.toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric',
      })
    }
  </div>
  <div class="case-head">
    <h2>{entry.data.title}</h2>
    <Stamp value={total} rotate={4} />
  </div>

  <div class="prose">
    <Content />
  </div>

  <h2 class="section-title">The scoring</h2>
  <div class="bars">
    {FACTORS.map((f) => <FactorBar factor={f} score={entry.data.scores[f.id]} />)}
  </div>
  <div class="receipt">{formulaString(entry.data.scores)}</div>

  <h2 class="section-title">Sources</h2>
  <ol class="sources">
    {
      entry.data.sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener">
            {s.label}
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .case-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 28px;
  }
  .case-head h2 {
    font-weight: 800;
    font-size: clamp(26px, 4vw, 36px);
    margin: 0;
    max-width: 560px;
  }
  .section-title {
    font-weight: 800;
    font-size: 24px;
    margin: 40px 0 20px;
  }
  .sources {
    font-size: 15px;
    color: var(--ink-soft);
  }
  .sources li {
    margin-bottom: 8px;
  }
</style>
